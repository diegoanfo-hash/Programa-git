<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Sistema de Gestión de Inventarios</display-name>

  <!-- Página de bienvenida -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Servlet Login -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.inventario.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <!-- Servlet Logout -->
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.inventario.servlet.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- Servlet Materias Primas -->
  <servlet>
    <servlet-name>MateriaPrimaServlet</servlet-name>
    <servlet-class>com.inventario.servlet.MateriaPrimaServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MateriaPrimaServlet</servlet-name>
    <url-pattern>/materias</url-pattern>
  </servlet-mapping>

  <!-- Servlet Movimientos -->
  <servlet>
    <servlet-name>MovimientoServlet</servlet-name>
    <servlet-class>com.inventario.servlet.MovimientoServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MovimientoServlet</servlet-name>
    <url-pattern>/movimientos</url-pattern>
  </servlet-mapping>

  <!-- Filtro de autenticación -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.inventario.servlet.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/materias</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/movimientos</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/jsp/*</url-pattern>
  </filter-mapping>

  <!-- Tiempo de sesión: 30 minutos -->
  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

</web-app>
